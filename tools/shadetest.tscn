code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D Texture2DParameter : source_color;
uniform float FloatParameter : hint_range(0.0, 1.0);



void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out2p0);


// VectorDecompose:5
	float n_out5p0 = n_out3p0.x;
	float n_out5p1 = n_out3p0.y;
	float n_out5p2 = n_out3p0.z;
	float n_out5p3 = n_out3p0.w;


// FloatParameter:7
	float n_out7p0 = FloatParameter;


	vec3 n_out6p0;
// If:6
	float n_in6p2 = 0.00001;
	vec3 n_in6p3 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in6p4 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_in6p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out5p0 - n_out7p0) < n_in6p2)
	{
		n_out6p0 = n_in6p3;
	}
	else if(n_out5p0 < n_out7p0)
	{
		n_out6p0 = n_in6p5;
	}
	else
	{
		n_out6p0 = n_in6p4;
	}


// Output:0
	ALBEDO = n_out6p0;


}
